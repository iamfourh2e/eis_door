API_PORT=4000
DOORWATCH_WEB_PORT=3080
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=doorwatch

# ZKBio CVSecurity connection. Keep this token server-side only.
ZKBIO_ENABLED=true
ZKBIO_BASE_URL=https://192.168.1.100:8088
ZKBIO_ACCESS_TOKEN=replace-with-your-api-token
ZKBIO_POLL_INTERVAL_MS=10000
ZKBIO_REQUEST_TIMEOUT_MS=8000
ZKBIO_ALLOW_INSECURE_TLS=false

# Optional remote DoorWatch server. Leave blank for local-only storage.
CENTRAL_SERVER_URL=
CENTRAL_SERVER_KEY=
COLLECTOR_ID=riverside-office-01

# Optional: provide your own base64-encoded 32-byte key. If blank, DoorWatch
# generates a persistent key in its Docker volume.
CONFIG_ENCRYPTION_KEY=

# Initial administrator. These values create the account only when the users
# collection is empty. Change the password before the first Docker startup.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=DoorWatch@123
SESSION_HOURS=12
SESSION_SECRET=
AUTH_COOKIE_SECURE=false
